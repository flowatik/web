# Copy this file to `.env` and fill in your own values.

# OpenAI API key for the Automation section's live demos.
#
# WARNING: Vite exposes any VITE_* variable in the bundled client JS. Anyone
# who opens the production site can read this key. Use ONLY with a key that
# is heavily rate-limited and spend-capped at the OpenAI dashboard. For a
# real public deployment, replace this with a serverless proxy that keeps
# the key on the server.
VITE_OPENAI_API_KEY=sk-...
